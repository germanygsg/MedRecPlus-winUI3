<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MedRecPlus.Core</RootNamespace>
    <AssemblyName>MedRecPlus.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Encrypted SQLite: Core (no default bundle) + SQLCipher bundle, per
         https://learn.microsoft.com/en-us/dotnet/standard/data/sqlite/custom-versions -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <!-- Argon2id password hashing / key derivation -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

</Project>

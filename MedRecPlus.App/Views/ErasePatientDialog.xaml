<ContentDialog
    x:Class="MedRecPlus.App.Views.ErasePatientDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Erase patient permanently?"
    PrimaryButtonText="Erase permanently"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    Style="{StaticResource AppDialogStyle}">

    <StackPanel Spacing="10" MaxWidth="480">
        <TextBlock TextWrapping="Wrap" Foreground="Red" FontWeight="SemiBold"
                   Text="This permanently deletes the patient, all visits, invoices, payment records and attachments (including files). It cannot be undone." />
        <TextBlock x:Name="ScopeText" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                   Text="Note: existing backup files are NOT touched — erase does not rewrite history in backups." />
        <TextBox x:Name="NameBox" Header="Type the patient's full name to confirm"
                 TextChanged="NameBox_TextChanged" />
    </StackPanel>
</ContentDialog>

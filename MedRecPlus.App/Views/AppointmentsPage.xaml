<Page
    x:Class="MedRecPlus.App.Views.AppointmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MedRecPlus.App">

    <Grid Padding="24,0,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <local:WrapPanel Grid.Row="0" Spacing="8">
            <ComboBox x:Name="RangeBox" SelectionChanged="RangeBox_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem Content="Today" />
                <ComboBoxItem Content="Last 7 days" />
                <ComboBoxItem Content="All" />
            </ComboBox>
            <Button Content="New visit" Click="NewVisit_Click" Style="{StaticResource AccentButtonStyle}" />
        </local:WrapPanel>

        <ListView Grid.Row="1" x:Name="VisitList" IsItemClickEnabled="True" ItemClick="Visit_Click" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <local:AdaptiveGrid ColumnSpacing="12" Padding="0,10" MinHeight="52" Columns="6" MinimumColumnWidth="140">

                        <TextBlock Text="{Binding Date}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Patient}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Operator}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Total}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Invoice}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="Delete" ContentTemplate="{StaticResource DeleteButtonContentTemplate}" Click="Delete_Click" Tag="{Binding Id}" VerticalAlignment="Center" />
                    </local:AdaptiveGrid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

<Page
    x:Class="MedRecPlus.App.Views.AppointmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,0,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="RangeBox" SelectionChanged="RangeBox_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem Content="Today" />
                <ComboBoxItem Content="Last 7 days" />
                <ComboBoxItem Content="All" />
            </ComboBox>
            <TextBox x:Name="SearchBox" PlaceholderText="Search patient…" Width="280"
                     TextChanged="SearchBox_TextChanged" />
            <Button Content="New visit" Click="NewVisit_Click" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="VisitList" IsItemClickEnabled="True"
                  ItemClick="Visit_Click" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" /><ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" /><ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Date}" />
                        <TextBlock Grid.Column="1" Text="{Binding Patient}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding Operator}" Opacity="0.7" />
                        <TextBlock Grid.Column="3" Text="{Binding Total}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding Invoice}" Opacity="0.7" />
                        <Button Grid.Column="5" Content="Delete" Click="Delete_Click" Tag="{Binding Id}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

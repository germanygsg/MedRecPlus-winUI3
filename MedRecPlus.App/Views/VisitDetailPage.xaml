<Page
    x:Class="MedRecPlus.App.Views.VisitDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,0,24,24">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="InvoiceButton" Content="Generate invoice" Click="Invoice_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Edit visit" Click="Edit_Click" />
                <Button Content="Delete" Click="Delete_Click" />
            </StackPanel>
            <TextBlock x:Name="FrozenNote" Foreground="Orange" Visibility="Collapsed"
                       Text="Invoiced — visit is frozen. Only treatment notes can be edited." />

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="MetaText" Opacity="0.7" />
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Vital signs" FontWeight="SemiBold" />
                    <TextBlock x:Name="VitalsText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Treatments" FontWeight="SemiBold" />
                    <ListView x:Name="TreatmentList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Notes, Mode=TwoWay}" PlaceholderText="Notes…"
                                                 Tag="{Binding Id}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Price}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Save treatment notes" Click="SaveNotes_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Totals" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtotalText" />
                    <TextBlock x:Name="DiscountText" />
                    <TextBlock x:Name="TotalText" FontWeight="Bold" FontSize="16" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

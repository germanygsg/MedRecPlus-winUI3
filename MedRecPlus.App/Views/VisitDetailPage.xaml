<Page
    x:Class="MedRecPlus.App.Views.VisitDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MedRecPlus.App">

    <ScrollViewer Padding="24,0,24,24">
        <StackPanel Spacing="16">
            <local:WrapPanel Spacing="8">
                <Button x:Name="InvoiceButton" Content="Generate invoice" Click="Invoice_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Edit visit" ContentTemplate="{StaticResource EditButtonContentTemplate}" Click="Edit_Click" />
                <Button Content="Delete" ContentTemplate="{StaticResource DeleteButtonContentTemplate}" Click="Delete_Click" />
            </local:WrapPanel>
            <TextBlock x:Name="FrozenNote" Foreground="Orange" Visibility="Collapsed" Text="Invoiced — visit is frozen. Only treatment notes can be edited." TextWrapping="Wrap" />

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="MetaText" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Vital signs" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="VitalsText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Treatments" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ListView x:Name="TreatmentList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <local:AdaptiveGrid ColumnSpacing="8" Padding="0,4" Columns="3" MinimumColumnWidth="140">

                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding Notes, Mode=TwoWay}" PlaceholderText="Notes…" Tag="{Binding Id}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Price}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </local:AdaptiveGrid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Save treatment notes" Click="SaveNotes_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Totals" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SubtotalText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DiscountText" TextWrapping="Wrap" />
                    <TextBlock x:Name="TotalText" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

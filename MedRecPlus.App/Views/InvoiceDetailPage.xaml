<Page
    x:Class="MedRecPlus.App.Views.InvoiceDetailPage"
    FontFamily="{StaticResource AppFontFamily}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MedRecPlus.App">

    <Grid>
        <ScrollViewer Padding="24,0,24,24">
            <StackPanel Spacing="16">
                <local:WrapPanel Spacing="8">
                    <Button Content="Record payment" Click="Pay_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="PrintButton" Content="Print invoice" Click="Print_Click" />
                    <Button Content="Delete" ContentTemplate="{StaticResource DeleteButtonContentTemplate}" Click="Delete_Click" />
                </local:WrapPanel>

                <TextBlock Text="Invoice paper: 12 cm wide × 13.8 cm high. Select 120 × 138 mm custom paper in your printer settings." TextWrapping="Wrap" Opacity="0.7" />

                <!-- Each preview sheet uses the same layout as its printed page. -->
                <StackPanel x:Name="ReceiptPanel" Spacing="16" />

                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Payments" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ListView x:Name="PaymentList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <local:AdaptiveGrid ColumnSpacing="12" Padding="0,6" Columns="3" MinimumColumnWidth="140">

                                        <TextBlock Text="{Binding Date}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Method}" Opacity="0.7" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Amount}" HorizontalAlignment="Right" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </local:AdaptiveGrid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <!-- Keep printable XAML in the visual tree without showing it on screen. -->
        <Canvas x:Name="PrintCanvas" Width="0" Height="0" IsHitTestVisible="False">
            <Canvas.RenderTransform><TranslateTransform X="-10000" Y="-10000" /></Canvas.RenderTransform>
        </Canvas>
    </Grid>
</Page>

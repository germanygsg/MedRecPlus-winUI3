<Page
    x:Class="MedRecPlus.App.Views.InvoiceDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,0,24,24">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Record payment" Click="Pay_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Mark void" Click="Void_Click" />
                <Button Content="Delete" Click="Delete_Click" />
            </StackPanel>

            <!-- Receipt preview (frozen representation) -->
            <Border Style="{StaticResource CardBorder}" Padding="20" Background="White">
                <StackPanel Spacing="4" x:Name="ReceiptPanel">
                    <TextBlock x:Name="ClinicHeader" FontWeight="Bold" FontSize="18" Foreground="Black" TextWrapping="Wrap" />
                    <TextBlock Text="TREATMENT RECEIPT" FontWeight="Bold" Foreground="Black"
                               HorizontalAlignment="Center" Margin="0,8,0,8" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Billed to" FontWeight="SemiBold" Foreground="Black" />
                            <TextBlock x:Name="BillTo" Foreground="Black" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Invoice info" FontWeight="SemiBold" Foreground="Black" />
                            <TextBlock x:Name="InvoiceInfo" Foreground="Black" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="LineItems" SelectionMode="None" Margin="0,8,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="Black" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Price}" Foreground="Black" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel HorizontalAlignment="Right" Spacing="2" Margin="0,8,0,0">
                        <TextBlock x:Name="SubtotalText" Foreground="Black" />
                        <TextBlock x:Name="DiscountText" Foreground="Black" />
                        <TextBlock x:Name="TaxText" Foreground="Black" />
                        <TextBlock x:Name="TotalText" Foreground="Black" FontWeight="Bold" FontSize="16" />
                        <TextBlock x:Name="PaidText" Foreground="Black" />
                    </StackPanel>
                    <TextBlock x:Name="OperatorInfo" Foreground="Black" Opacity="0.7" Margin="0,8,0,0" />
                    <TextBlock x:Name="ClinicFooter" Foreground="Black" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Payments" FontWeight="SemiBold" />
                    <ListView x:Name="PaymentList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" /><ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Date}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Method}" Opacity="0.7" />
                                    <TextBlock Grid.Column="2" Text="{Binding Amount}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

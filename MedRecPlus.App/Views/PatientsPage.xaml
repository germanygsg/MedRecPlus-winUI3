<Page
    x:Class="MedRecPlus.App.Views.PatientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MedRecPlus.App">

    <Grid Padding="24,0,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <local:WrapPanel Grid.Row="0" Spacing="8">
            <Button Content="Add patient" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" />
        </local:WrapPanel>

        <ListView Grid.Row="1" x:Name="PatientList" IsItemClickEnabled="True" ItemClick="Patient_Click" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <local:AdaptiveGrid ColumnSpacing="12" Padding="0,10" MinHeight="52" Columns="6" MinimumColumnWidth="140">

                        <TextBlock Text="{Binding RecordNumber}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Age}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Phone}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="Edit" ContentTemplate="{StaticResource EditButtonContentTemplate}" Click="Edit_Click" Tag="{Binding Id}" VerticalAlignment="Center" />
                        <Button Content="Delete" ContentTemplate="{StaticResource DeleteButtonContentTemplate}" Click="Delete_Click" Tag="{Binding Id}" VerticalAlignment="Center" />
                    </local:AdaptiveGrid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

<Page
    x:Class="MedRecPlus.App.Views.PatientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,0,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" PlaceholderText="Search name, record number, phone…"
                     Width="340" TextChanged="SearchBox_TextChanged" />
            <Button Content="Add patient" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="PatientList" IsItemClickEnabled="True"
                  ItemClick="Patient_Click" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" /><ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" /><ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RecordNumber}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                        <TextBlock Grid.Column="2" Text="{Binding Age}" />
                        <TextBlock Grid.Column="3" Text="{Binding Phone}" Opacity="0.7" />
                        <Button Grid.Column="4" Content="Edit" Click="Edit_Click" Tag="{Binding Id}" />
                        <Button Grid.Column="5" Content="Delete" Click="Delete_Click" Tag="{Binding Id}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

<ContentDialog
    x:Class="MedRecPlus.App.Views.PaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Record payment"
    PrimaryButtonText="Record"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource AppDialogStyle}">

    <StackPanel Spacing="10">
        <TextBlock x:Name="BalanceText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Style="{StaticResource FieldErrorStyle}" TextWrapping="Wrap" />
        <StackPanel Spacing="4">
            <NumberBox x:Name="AmountBox" Header="Amount (Rp) *" Minimum="1" />
            <TextBlock x:Name="AmountBoxError" Style="{StaticResource FieldErrorStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
            <ComboBox x:Name="MethodBox" Header="Method" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="Cash" Tag="cash" />
                <ComboBoxItem Content="Transfer" Tag="transfer" />
                <ComboBoxItem Content="QRIS" Tag="qris" />
                <ComboBoxItem Content="Card" Tag="card" />
                <ComboBoxItem Content="Other" Tag="other" />
            </ComboBox>
            <TextBlock x:Name="MethodBoxError" Style="{StaticResource FieldErrorStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBox x:Name="NoteBox" Header="Note" />
    </StackPanel>
</ContentDialog>

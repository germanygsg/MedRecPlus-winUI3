<ContentDialog
    x:Class="MedRecPlus.App.Views.PaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Record payment"
    PrimaryButtonText="Record"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource AppDialogStyle}">

    <StackPanel Spacing="10" MinWidth="380">
        <TextBlock x:Name="BalanceText" FontWeight="SemiBold" />
        <NumberBox x:Name="AmountBox" Header="Amount (Rp) *" Minimum="1" />
        <ComboBox x:Name="MethodBox" Header="Method" HorizontalAlignment="Stretch" SelectedIndex="0">
            <ComboBoxItem Content="Cash" Tag="cash" />
            <ComboBoxItem Content="Transfer" Tag="transfer" />
            <ComboBoxItem Content="QRIS" Tag="qris" />
            <ComboBoxItem Content="Card" Tag="card" />
            <ComboBoxItem Content="Other" Tag="other" />
        </ComboBox>
        <TextBox x:Name="NoteBox" Header="Note" />
        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>

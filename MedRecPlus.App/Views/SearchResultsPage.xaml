<Page
    x:Class="MedRecPlus.App.Views.SearchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,0,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <AutoSuggestBox x:Name="ResultsSearchBox" MinWidth="280" MaxWidth="516" HorizontalAlignment="Stretch"
                        PlaceholderText="Search patients, appointments, invoices…"
                        AutomationProperties.Name="Search all records" QueryIcon="Find"
                        QuerySubmitted="ResultsSearchBox_QuerySubmitted" />
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressRing x:Name="SearchProgress" IsActive="False" Visibility="Collapsed"
                          Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="RetryButton" Content="Retry search" Visibility="Collapsed" Click="Retry_Click" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ResultGroups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="8" Margin="0,0,0,24">
                            <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <ListView ItemsSource="{Binding Items}" SelectionMode="None"
                                      IsItemClickEnabled="True" ItemClick="Result_Click">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,8" Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.7" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Load more" Visibility="{Binding MoreVisibility}"
                                    Tag="{Binding}" Click="LoadMore_Click" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>

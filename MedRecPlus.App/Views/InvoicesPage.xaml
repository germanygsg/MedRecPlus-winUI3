<Page
    x:Class="MedRecPlus.App.Views.InvoicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,0,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="StatusBox" SelectionChanged="Filter_Changed" SelectedIndex="0">
                <ComboBoxItem Content="All statuses" Tag="" />
                <ComboBoxItem Content="Unpaid" Tag="unpaid" />
                <ComboBoxItem Content="Paid" Tag="paid" />
                <ComboBoxItem Content="Void" Tag="void" />
            </ComboBox>
            <TextBox x:Name="SearchBox" PlaceholderText="Search number or patient…" Width="280"
                     TextChanged="Filter_Changed" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="InvoiceList" IsItemClickEnabled="True"
                  ItemClick="Invoice_Click" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" /><ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Number}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Patient}" />
                        <TextBlock Grid.Column="2" Text="{Binding Date}" Opacity="0.7" />
                        <TextBlock Grid.Column="3" Text="{Binding Total}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding Status}" Opacity="0.7" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

<Page
    x:Class="MedRecPlus.App.Views.InvoicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MedRecPlus.App">

    <Grid Padding="24,0,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <local:WrapPanel Grid.Row="0" Spacing="8">
            <ComboBox x:Name="StatusBox" SelectionChanged="Filter_Changed" SelectedIndex="0">
                <ComboBoxItem Content="All statuses" Tag="" />
                <ComboBoxItem Content="Unpaid" Tag="unpaid" />
                <ComboBoxItem Content="Paid" Tag="paid" />
                <ComboBoxItem Content="Void" Tag="void" />
            </ComboBox>
        </local:WrapPanel>

        <ListView Grid.Row="1" x:Name="InvoiceList" IsItemClickEnabled="True" ItemClick="Invoice_Click" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <local:AdaptiveGrid ColumnSpacing="12" Padding="0,10" MinHeight="52" Columns="5" MinimumColumnWidth="140">

                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Patient}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Date}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Total}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </local:AdaptiveGrid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

<Page
    x:Class="MedRecPlus.App.Views.PatientDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,0,24,24">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Edit" Click="Edit_Click" />
                <Button Content="New visit" Click="NewVisit_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Export JSON" Click="Export_Click" />
                <Button Content="Erase…" Click="Erase_Click" />
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="NameText" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="RecordText" Opacity="0.7" />
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DiagnosisText" TextWrapping="Wrap" />
                    <StackPanel x:Name="IcdChips" Orientation="Horizontal" Spacing="6" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Lawful basis" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConsentText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Visits" FontWeight="SemiBold" />
                    <ListView x:Name="VisitList" IsItemClickEnabled="True" ItemClick="Visit_Click" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" /><ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Date}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Operator}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Total}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding Invoice}" Opacity="0.7" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Attachments" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Add image" Click="AddAttachment_Click" />
                    </StackPanel>
                    <ListView x:Name="AttachmentList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Size}" Opacity="0.7" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Delete" Click="AttachmentDelete_Click" Tag="{Binding Id}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

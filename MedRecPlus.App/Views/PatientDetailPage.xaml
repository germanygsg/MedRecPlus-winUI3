<Page
    x:Class="MedRecPlus.App.Views.PatientDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MedRecPlus.App">

    <ScrollViewer Padding="24,0,24,24">
        <StackPanel Spacing="16">
            <local:WrapPanel Spacing="8">
                <Button Content="Edit" ContentTemplate="{StaticResource EditButtonContentTemplate}" Click="Edit_Click" />
                <Button Content="New visit" Click="NewVisit_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Export JSON" Click="Export_Click" />
                <Button Content="Erase…" Click="Erase_Click" />
            </local:WrapPanel>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="NameText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="RecordText" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DiagnosisText" TextWrapping="Wrap" />
                    <local:WrapPanel x:Name="IcdChips" Spacing="6" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Lawful basis" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConsentText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Visits" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ListView x:Name="VisitList" IsItemClickEnabled="True" ItemClick="Visit_Click" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <local:AdaptiveGrid ColumnSpacing="12" Padding="0,8" Columns="4" MinimumColumnWidth="140">

                                    <TextBlock Text="{Binding Date}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Operator}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Total}" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Invoice}" Opacity="0.7" TextWrapping="Wrap" />
                                </local:AdaptiveGrid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="8">
                    <local:WrapPanel Spacing="8">
                        <TextBlock Text="Attachments" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="Add image" Click="AddAttachment_Click" />
                    </local:WrapPanel>
                    <ListView x:Name="AttachmentList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <local:AdaptiveGrid ColumnSpacing="12" Padding="0,6" Columns="3" MinimumColumnWidth="140">

                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Size}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Content="Delete" ContentTemplate="{StaticResource DeleteButtonContentTemplate}" Click="AttachmentDelete_Click" Tag="{Binding Id}" />
                                </local:AdaptiveGrid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

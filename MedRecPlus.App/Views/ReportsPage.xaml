<Page
    x:Class="MedRecPlus.App.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MedRecPlus.App">

    <ScrollViewer Padding="24,24,24,24">
        <StackPanel Spacing="16">

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Export" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Save clinic records or annual operator performance as an Excel workbook." TextWrapping="Wrap" Opacity="0.7" />
                    <Button x:Name="DataExportButton" Click="ExportData_Click" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="DataExportProgress" IsActive="False" Visibility="Collapsed" Width="18" Height="18" />
                            <TextBlock Text="Export data (Excel)" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <local:WrapPanel Spacing="8">
                        <ComboBox x:Name="ExportYearBox" Header="Year" />
                        <ComboBox x:Name="ExportOperatorBox" Header="Operator" MinWidth="180" MaxWidth="320" />
                    </local:WrapPanel>
                    <TextBlock Text="Annual totals use visit dates; collections use payment dates, including receipts from earlier years." TextWrapping="Wrap" Opacity="0.7" />
                    <Button x:Name="OperatorExportButton" Click="ExportOperators_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="OperatorExportProgress" IsActive="False" Visibility="Collapsed" Width="18" Height="18" />
                            <TextBlock Text="Export operator performance" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Operator performance" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                    <local:WrapPanel Spacing="8">
                        <ComboBox x:Name="MonthBox" Header="Month" SelectionChanged="Filter_Changed" />
                        <ComboBox x:Name="YearBox" Header="Year" SelectionChanged="Filter_Changed" />
                    </local:WrapPanel>
                    <ListView x:Name="OperatorList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <local:AdaptiveGrid ColumnSpacing="12" Padding="0,8" Columns="3" MinimumColumnWidth="140">

                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Visits}" Opacity="0.7" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Revenue}" HorizontalAlignment="Right" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </local:AdaptiveGrid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Patient visit history" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                    <TextBox x:Name="PatientSearchBox" PlaceholderText="Search patient…" TextChanged="PatientSearch_Changed" HorizontalAlignment="Stretch" />
                    <ListView x:Name="PatientResults" MaxHeight="130" IsItemClickEnabled="True" ItemClick="PatientResult_Click" SelectionMode="None" Visibility="Collapsed" />
                    <TextBlock x:Name="TrendTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ListView x:Name="TrendList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="0,6">
                                    <TextBlock Text="{Binding Date}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Vitals}" TextWrapping="Wrap" Opacity="0.8" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

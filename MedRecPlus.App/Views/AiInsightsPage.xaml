<Page
    x:Class="MedRecPlus.App.Views.AiInsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MedRecPlus.App">

    <Grid Padding="24,0,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Deterministic local analytics — no cloud, no LLM. Analytics only, not medical advice." Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <local:WrapPanel Grid.Row="1" Spacing="6">
            <Button Content="Clinic overview" Click="Suggest_Click" Tag="Give me a clinic overview" />
            <Button Content="Revenue" Click="Suggest_Click" Tag="What is our revenue this month?" />
            <Button Content="Unpaid invoices" Click="Suggest_Click" Tag="Show me unpaid invoices" />
            <Button Content="Top operators" Click="Suggest_Click" Tag="Who are our top operators?" />
        </local:WrapPanel>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="QuestionBox" PlaceholderText="Ask about your data… (Indonesian or English)" KeyDown="QuestionBox_KeyDown" />
            <Button Grid.Column="1" Content="Ask" Click="Ask_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource CardBorder}" Padding="16" x:Name="AnswerCard" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="AnswerText" TextWrapping="Wrap" />
                        <ListView x:Name="KpiList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <local:AdaptiveGrid ColumnSpacing="12" Columns="2" MinimumColumnWidth="140">

                                        <TextBlock Text="{Binding Label}" Opacity="0.7" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </local:AdaptiveGrid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Expander Header="Data sources &amp; evidence">
                            <ListView x:Name="EvidenceList" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,4">
                                            <TextBlock Text="{Binding Source}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

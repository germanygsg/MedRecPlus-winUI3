<Page
    x:Class="MedRecPlus.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MedRecPlus.App">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PatientCardBrush" Color="#F7F3FE" />
                    <SolidColorBrush x:Key="VisitCardBrush" Color="#F1F8F5" />
                    <SolidColorBrush x:Key="RevenueCardBrush" Color="#FFFAF2" />
                    <SolidColorBrush x:Key="QuickCardBrush" Color="#F5F4FC" />
                    <SolidColorBrush x:Key="AvatarBrush" Color="#E8DFFE" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PatientCardBrush" Color="#292434" />
                    <SolidColorBrush x:Key="VisitCardBrush" Color="#202D28" />
                    <SolidColorBrush x:Key="RevenueCardBrush" Color="#302A21" />
                    <SolidColorBrush x:Key="QuickCardBrush" Color="#272532" />
                    <SolidColorBrush x:Key="AvatarBrush" Color="#483767" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PatientCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="VisitCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="RevenueCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="QuickCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AvatarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="BentoCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="MinHeight" Value="342" />
            </Style>
            <Style x:Key="PeriodPicker" TargetType="ComboBox">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinWidth" Value="132" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="CardHeading" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer x:Name="DashboardScroll" Padding="24,0,24,24" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">
            <local:AdaptiveGrid x:Name="BentoGrid" Columns="2" MinimumColumnWidth="350" ColumnSpacing="20" RowSpacing="20">
                <Border x:Name="PatientsCard" Style="{StaticResource BentoCard}" Background="{ThemeResource PatientCardBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="20,14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8FA;" FontSize="17" Opacity="0.6" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="New patients" Style="{StaticResource CardHeading}" />
                                </Grid>
                                <ComboBox x:Name="PatientRange" Grid.Column="1" Style="{StaticResource PeriodPicker}" SelectedIndex="0" SelectionChanged="Range_SelectionChanged" AutomationProperties.Name="New patients date range">
                                    <ComboBoxItem Content="Last 7 days" /><ComboBoxItem Content="Last 30 days" /><ComboBoxItem Content="Last 90 days" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Padding="20,16,20,12">
                            <FontIcon Glyph="&#xE8FA;" FontSize="110" Opacity="0.045" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Spacing="6">
                                <local:WrapPanel Spacing="12">
                                    <TextBlock x:Name="PatientsCount" Text="0" FontSize="34" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Click="AddPatient_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Add patient"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock Text="Add" FontSize="12" /></StackPanel></Button>
                                </local:WrapPanel>
                                <TextBlock x:Name="PatientsSub" Text="New registrations in this period" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <local:DashboardChart x:Name="PatientChart" Margin="-4,6,-4,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="AppointmentsCard" Style="{StaticResource BentoCard}" Background="{ThemeResource VisitCardBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="20,14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE787;" FontSize="17" Opacity="0.6" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Appointments" Style="{StaticResource CardHeading}" />
                                </Grid>
                                <ComboBox x:Name="AppointmentRange" Grid.Column="1" Style="{StaticResource PeriodPicker}" SelectedIndex="0" SelectionChanged="Range_SelectionChanged" AutomationProperties.Name="Appointments date range">
                                    <ComboBoxItem Content="Last 7 days" /><ComboBoxItem Content="Last 30 days" /><ComboBoxItem Content="Last 90 days" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Padding="20,16,20,12">
                            <FontIcon Glyph="&#xE787;" FontSize="110" Opacity="0.045" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Spacing="6">
                                <local:WrapPanel Spacing="12">
                                    <TextBlock x:Name="VisitsToday" Text="0" FontSize="34" FontWeight="Bold" VerticalAlignment="Center" />
                                </local:WrapPanel>
                                <TextBlock x:Name="VisitsSub" Text="Visits in this period" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <local:DashboardChart x:Name="AppointmentChart" Margin="-4,6,-4,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="RevenueCard" Style="{StaticResource BentoCard}" Background="{ThemeResource RevenueCardBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="20,14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8C7;" FontSize="17" Opacity="0.6" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Revenue" Style="{StaticResource CardHeading}" />
                                </Grid>
                                <ComboBox x:Name="RevenueRange" Grid.Column="1" Style="{StaticResource PeriodPicker}" SelectedIndex="0" SelectionChanged="Range_SelectionChanged" AutomationProperties.Name="Revenue date range">
                                    <ComboBoxItem Content="Last 7 days" /><ComboBoxItem Content="Last 30 days" /><ComboBoxItem Content="Last 90 days" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Padding="20,16,20,12">
                            <FontIcon Glyph="&#xE8C7;" FontSize="110" Opacity="0.045" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Spacing="6">
                                <local:WrapPanel Spacing="12">
                                    <TextBlock x:Name="RevenueMonth" Text="Rp 0" FontSize="34" FontWeight="Bold" VerticalAlignment="Center" />
                                </local:WrapPanel>
                                <TextBlock Text="Fully paid invoices · by issue date · IDR" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <local:DashboardChart x:Name="RevenueChart" Margin="-4,6,-4,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="QuickAccessCard" Style="{StaticResource BentoCard}" Background="{ThemeResource QuickCardBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Padding="20,14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE716;" FontSize="17" Opacity="0.6" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Patient quick access" Style="{StaticResource CardHeading}" />
                                </Grid>
                                <ComboBox x:Name="QuickRange" Grid.Column="1" Style="{StaticResource PeriodPicker}" SelectedIndex="0" SelectionChanged="Range_SelectionChanged" AutomationProperties.Name="Patient quick access date range">
                                    <ComboBoxItem Content="Last 7 days" /><ComboBoxItem Content="Last 30 days" /><ComboBoxItem Content="Last 90 days" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="8,8">
                            <ListView x:Name="QuickPatients" IsItemClickEnabled="True" ItemClick="Patient_Click" SelectionMode="None" AutomationProperties.Name="Recently registered or seen patients" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="4,9">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource AvatarBrush}" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Visits}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="QuickEmpty" Spacing="8" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"><FontIcon Glyph="&#xE716;" FontSize="30" Opacity="0.4" /><TextBlock Text="No patient activity in this period" TextAlignment="Center" FontSize="13" /><TextBlock Text="Add a patient or choose a longer date range." FontSize="12" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        </Grid>
                        <local:WrapPanel Grid.Row="2" Margin="20,4,20,16" Spacing="8">
                            <Button Click="NewVisit_Click" Style="{StaticResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock Text="New visit" FontSize="12" /></StackPanel></Button>
                            <Button Content="All patients" Click="AllPatients_Click" FontSize="12" />
                        </local:WrapPanel>
                    </Grid>
                </Border>
            </local:AdaptiveGrid>

            <Border Style="{StaticResource CardBorder}" CornerRadius="14" Padding="18,14">
                <local:WrapPanel Spacing="14">
                    <FontIcon Glyph="&#xE8EA;" FontSize="20" Opacity="0.6" VerticalAlignment="Center" />
                    <StackPanel Spacing="3"><TextBlock x:Name="UnpaidCount" FontWeight="SemiBold" /><TextBlock x:Name="UnpaidSub" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                    <Button Content="View invoices" Click="AllInvoices_Click" FontSize="12" VerticalAlignment="Center" />
                </local:WrapPanel>
            </Border>
            <TextBlock Text="Recent invoices" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="InvoicesEmpty" Text="No invoices yet. Create a visit to get started." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView x:Name="RecentInvoices" IsItemClickEnabled="True" ItemClick="Invoice_Click" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <local:AdaptiveGrid ColumnSpacing="12" Padding="0,8" Columns="4" MinimumColumnWidth="140">
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Patient}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Total}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" />
                        </local:AdaptiveGrid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

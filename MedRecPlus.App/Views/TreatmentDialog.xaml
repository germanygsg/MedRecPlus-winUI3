<ContentDialog
    x:Class="MedRecPlus.App.Views.TreatmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New treatment"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource AppDialogStyle}">

    <StackPanel Spacing="10">
        <TextBlock x:Name="ErrorText" Style="{StaticResource FieldErrorStyle}" TextWrapping="Wrap" />
        <StackPanel Spacing="4">
            <TextBox x:Name="NameBox" Header="Name *" />
            <TextBlock x:Name="NameBoxError" Style="{StaticResource FieldErrorStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBox x:Name="DescBox" Header="Description" />
        <StackPanel Spacing="4">
            <TextBox x:Name="PriceBox" Header="Price (Rp) *" PlaceholderText="e.g. 300000" InputScope="Number" />
            <TextBlock x:Name="PriceBoxError" Style="{StaticResource FieldErrorStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</ContentDialog>

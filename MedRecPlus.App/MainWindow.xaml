<Window
    x:Class="MedRecPlus.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Title="MedRecPlus"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="False"
                  BackRequested="AppTitleBar_BackRequested"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.LeftHeader>
                <Button x:Name="SidebarToggleButton" Visibility="Collapsed"
                        Width="40" Height="40" Padding="8" Click="SidebarToggle_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="Collapse sidebar" ToolTipService.ToolTip="Collapse sidebar">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="24" Height="24" />
                </Button>
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <Grid x:Name="ShellSearchHost" Visibility="Collapsed"
                      MinWidth="120" MaxWidth="516" HorizontalAlignment="Stretch">
                    <AutoSuggestBox x:Name="ShellSearchBox"
                                    Visibility="Collapsed"
                                    MinWidth="120" MaxWidth="516"
                                    Height="32" CornerRadius="16" BorderThickness="1"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Search records and sections"
                                    AutomationProperties.Name="Search patients, appointments, invoices, and sections"
                                    TextMemberPath="Title"
                                    TextChanged="ShellSearchBox_TextChanged"
                                    QuerySubmitted="ShellSearchBox_QuerySubmitted">
                        <AutoSuggestBox.Resources>
                            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ControlFillColorTertiaryBrush" />
                            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ControlFillColorInputActiveBrush" />
                            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlStrokeColorDefaultBrush" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                        </AutoSuggestBox.Resources>
                        <AutoSuggestBox.TextBoxStyle>
                            <Style TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
                                <Setter Property="Padding" Value="36,4,12,4" />
                            </Style>
                        </AutoSuggestBox.TextBoxStyle>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Padding="0,4" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding Heading}" Visibility="{Binding HeadingVisibility}"
                                               FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Margin="0,4,0,4" AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                        <AutoSuggestBox.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
                        </AutoSuggestBox.KeyboardAccelerators>
                    </AutoSuggestBox>
                    <Button Width="32" Height="32" Margin="4,0,0,0" Padding="0"
                            HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="16"
                            Style="{StaticResource SubtleButtonStyle}" IsTabStop="False"
                            Click="ShellSearchSubmit_Click" AutomationProperties.Name="Search"
                            ToolTipService.ToolTip="Search">
                        <FontIcon Glyph="&#xE721;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" />
                    </Button>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <!-- Auth layer: first-run setup or unlock. Hidden after success. -->
        <Frame x:Name="AuthFrame" Grid.Row="1" />

        <!-- Main shell: shown after setup/unlock. -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        Visibility="Collapsed"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        AlwaysShowHeader="True"
                        OpenPaneLength="240"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewHeaderMargin">0</Thickness>
                <Thickness x:Key="NavigationViewMinimalHeaderMargin">0</Thickness>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <CornerRadius x:Key="NavigationViewMinimalContentGridCornerRadius">0</CornerRadius>
            </NavigationView.Resources>
            <NavigationView.Header>
                <!-- The shell toggles this header: sidebar pages get none (NavView.Header
                     is nulled out), drill-down pages show their contextual title. -->
                <TextBlock x:Name="SectionTitle" Text="Dashboard"
                           FontSize="28" FontWeight="SemiBold"
                           Margin="24,12,24,16" TextTrimming="CharacterEllipsis"
                           AutomationProperties.HeadingLevel="Level1" />
            </NavigationView.Header>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Patients" Tag="Patients">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Appointments" Tag="Appointments">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="CalendarDay" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Invoices" Tag="Invoices">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Reports" Tag="Reports">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="ShowResults" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI Insights" Tag="AiInsights">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Comment" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated"
                   KeyboardAcceleratorPlacementMode="Hidden">
                <Frame.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
                </Frame.KeyboardAccelerators>
            </Frame>
        </NavigationView>
    </Grid>
</Window>

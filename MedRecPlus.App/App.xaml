<Application
    x:Class="MedRecPlus.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources>
                    <!-- The WinUI default caps the dialog card at 756px; let dialogs grow with the window. -->
                    <controls:XamlControlsResources.MergedDictionaries>
                        <ResourceDictionary>
                            <x:Double x:Key="ContentDialogMaxHeight">10000</x:Double>
                        </ResourceDictionary>
                    </controls:XamlControlsResources.MergedDictionaries>
                </controls:XamlControlsResources>
            </ResourceDictionary.MergedDictionaries>
            <!-- Bundle Inter so every clinic PC uses the same typography offline. -->
            <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
            <!-- The title bar uses this named style rather than the implicit text style. -->
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="RichTextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="NumberBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <DataTemplate x:Key="EditButtonContentTemplate">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE70F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="DeleteButtonContentTemplate">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>
            <Style x:Key="DeleteConfirmationButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource DeleteButtonContentTemplate}" />
            </Style>
            <Style x:Key="FieldErrorStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            </Style>
            <!-- Calendar day and month labels have their own font properties. -->
            <Style TargetType="CalendarView" BasedOn="{StaticResource DefaultCalendarViewStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="DayItemFontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FirstOfMonthLabelFontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="MonthYearItemFontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FirstOfYearDecadeLabelFontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <!-- The dialog layer must fill the window; only its inner card is width-limited. -->
            <Style x:Key="AppDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="ContentDialog" BasedOn="{StaticResource AppDialogStyle}" />
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- Shared data-table visuals:Patients / Appointments / Invoices pages. -->
            <Style x:Key="TableItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <SolidColorBrush x:Key="RecordPillBrush" Color="#207C3AED" />
            <SolidColorBrush x:Key="RowActionTintBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.14" />
            <SolidColorBrush x:Key="StatusChipPaidBrush" Color="#2610B981" />
            <SolidColorBrush x:Key="StatusChipUnpaidBrush" Color="#26F59E0B" />
            <SolidColorBrush x:Key="StatusChipVoidBrush" Color="#266B7280" />
            <SolidColorBrush x:Key="StatusPaidTextBrush" Color="#059669" />
            <SolidColorBrush x:Key="StatusUnpaidTextBrush" Color="#B45309" />
            <SolidColorBrush x:Key="StatusVoidTextBrush" Color="#6B7280" />
            <Style x:Key="RowActionButton" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="RowViewButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                <Setter Property="Background" Value="{StaticResource RowActionTintBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="RowEditButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                <Setter Property="Background" Value="#2610B981" />
                <Setter Property="Foreground" Value="#059669" />
            </Style>
            <Style x:Key="RowDeleteButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                <Setter Property="Background" Value="#26DC2626" />
                <Setter Property="Foreground" Value="#DC2626" />
            </Style>
            <Style x:Key="PageNavButton" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="TableColumnDragThumbStyle" TargetType="primitives:Thumb">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Grip.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="Grip.Width" Value="2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Grip.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="Grip.Width" Value="2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Grip" Width="1" Margin="0,2" HorizontalAlignment="Center"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TableColumnResizeHandleStyle" TargetType="Control">
                <Setter Property="Width" Value="10" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,-6,-5,-6" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Control">
                            <!-- Thumb starts a pointer drag only when it has a layout parent. -->
                            <Grid Background="Transparent">
                                <primitives:Thumb x:Name="DragThumb" IsTabStop="False"
                                                  Style="{StaticResource TableColumnDragThumbStyle}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
